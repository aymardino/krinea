# Copy to .env for docker compose. Everything is optional except SECRET_KEY in production.
SECRET_KEY=change-me
POSTGRES_PASSWORD=krinea
BASE_URL=http://localhost:3000            # public URL of the web app (links in e-mails); browsers reach the API at <BASE_URL>/api
COOKIE_SECURE=false                       # true behind HTTPS
EMAIL_PROVIDER=console                    # console | resend | smtp
RESEND_API_KEY=                           # resend: needs a verified sending domain
# smtp: any mailbox works without a domain, e.g. Gmail with an app password
# (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, EMAIL_FROM="Krinea <you@gmail.com>")
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Included AI credits (D-16): leave empty to require users' own keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
UNPAYWALL_EMAIL=
# Object storage for PDFs in production (S3-compatible). Empty = local DATA_DIR.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sign in with Google (optional): OAuth client of type "Web application" in Google Cloud Console,
# authorised redirect URI = <BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
