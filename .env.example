# Copy to .env for docker compose. Everything is optional except SECRET_KEY in production.
SECRET_KEY=change-me
POSTGRES_PASSWORD=tamis
BASE_URL=http://localhost:3000            # where the web app is served (cookies, links in e-mails)
NEXT_PUBLIC_API_URL=http://localhost:8000 # where the browser reaches the API
COOKIE_SECURE=false                       # true behind HTTPS
EMAIL_PROVIDER=console                    # console | resend
RESEND_API_KEY=
# Included AI credits (D-16): leave empty to require users' own keys
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
UNPAYWALL_EMAIL=
# Object storage for PDFs in production (S3-compatible). Empty = local DATA_DIR.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Sign in with Google (optional): OAuth client of type "Web application" in Google Cloud Console,
# authorised redirect URI = <API_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
