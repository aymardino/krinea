# Krinea configuration. Copy to .env next to docker-compose.yml (docker compose reads it) and
# fill in at least SECRET_KEY. The variable names match apps/api/krinea_api/config.py.
#
# Format: one VARIABLE=value per line, comments on their own lines only (a comment written
# after a value becomes part of the value). Optional settings are commented out: uncomment
# a line to set it, and leave unset what you do not use.

# ── Required ─────────────────────────────────────────────────────────────────────────────
# Run mode. production is required on any public server (docker compose always sets it):
# no debug sign-in links, secure cookies, a real SECRET_KEY and a real e-mail provider.
# Leave it out only for local development without Docker (the default is development).
KRINEA_ENV=production

# Signs sessions and the web-to-API proxy key. Replace with at least 16 random characters,
# for example the output of: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty, docker compose stops with "Set SECRET_KEY in .env"; in production the API
# also refuses to start with a value shorter than 16 characters or with a placeholder
# such as change-me.
SECRET_KEY=

# Public URL of the web app, without a trailing slash: links in e-mails, Google sign-in,
# and the origin the web proxy reports to the API. Required in production, for example
# https://krinea.org (the browser reaches the API at <BASE_URL>/api).
BASE_URL=http://localhost:3000

# Set to true as soon as the site is served over HTTPS (any public server)
COOKIE_SECURE=false

# Password of the bundled PostgreSQL (docker compose); change it on a shared machine
POSTGRES_PASSWORD=krinea

# ── E-mail (sign-in links, invitations) ──────────────────────────────────────────────────
# smtp (any mailbox) or resend. console only prints the messages in the API log: fine for
# development, but in production the API then refuses to send (the error names the reason)
# and the sign-in page hides the e-mail-link option.
EMAIL_PROVIDER=console

# SMTP. The hosted krinea.org service sends through an OVHcloud mailbox (France, EU):
#   SMTP_HOST=ssl0.ovh.net
#   SMTP_PORT=465
#   SMTP_USER=contact@your-domain.org
# Gmail works without a domain of your own, with an app password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# TLS mode: ssl = implicit TLS (always used on port 465); unset = STARTTLS (port 587)
# SMTP_TLS=ssl
# Sender of the messages. With SMTP it must be the mailbox itself (or one of its aliases).
# EMAIL_FROM="Krinea <contact@your-domain.org>"

# Operator: addresses that can open /app/admin (comma-separated). Each sign-up sends a short
# notice to NOTIFY_SIGNUPS_TO, or to the first administrator when it is unset.
# ADMIN_EMAILS=you@your-domain.org
# NOTIFY_SIGNUPS_TO=you@your-domain.org
# Audience counts of the public pages, without cookies (shown on /app/admin). 0 switches them off.
# AUDIENCE_STATS=1

# Resend instead of SMTP (EMAIL_PROVIDER=resend): needs a sending domain verified at Resend
# RESEND_API_KEY=

# ── PDF storage ──────────────────────────────────────────────────────────────────────────
# Unset S3_BUCKET = files on local disk (DATA_DIR, the pdfs volume of docker compose).
# Any S3-compatible object storage works (Cloudflare R2, Backblaze B2, OVHcloud, AWS S3).
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Region of the bucket; R2 uses auto (the default)
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── AI credits included by the server (D-16) ─────────────────────────────────────────────
# Leave the keys unset to let each user bring their own API key.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# Monthly token allowance on the server keys, per plan
# FREE_AI_TOKENS_PER_MONTH=0
# PRO_AI_TOKENS_PER_MONTH=5000000

# Contact e-mail sent to Unpaywall (their API asks for one) to fetch open-access PDFs by DOI
# UNPAYWALL_EMAIL=you@example.org

# ── Sign in with Google (optional) ───────────────────────────────────────────────────────
# OAuth client of type "Web application" in Google Cloud Console, with the authorised
# redirect URI <BASE_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Optional tuning (defaults shown) ─────────────────────────────────────────────────────
# Run background jobs (imports, AI screening and extraction) inside the API process
# instead of the worker: default 0 in production, 1 in development. docker compose always
# runs the worker and sets 0.
# INLINE_JOBS=0
# Origins allowed to call the API directly, comma-separated (default: BASE_URL)
# CORS_ORIGINS=https://krinea.org
# Largest accepted upload, in MB
# MAX_UPLOAD_MB=200
# Session lifetime in days
# SESSION_DAYS=30
# Validity of a sign-in link, in minutes
# MAGIC_LINK_MINUTES=20

# ── Streamlit edition only (review_app.py, not used by the API) ──────────────────────────
# Default interface language (en or fr) and default reviewer name
# APP_LANG=en
# REVIEWER=
